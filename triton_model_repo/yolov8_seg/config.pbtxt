name: "yolov8_seg"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [116, 8400]
  },
  {
    name: "output1"
    data_type: TYPE_FP32
    dims: [32, 160, 160]
  }
]

instance_group [{
  kind: KIND_CPU
  count: 1
}]
